# Cabeceras de seguridad para los archivos estáticos (admin.html, panel.html, stats.html, la landing…).
# Las páginas de las Functions las ponen en lib/util.js (SEGURIDAD).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=()

# La página principal siempre se pide nueva (un celular quedó con una versión vieja del botón "Tócalo tú")
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# El service worker (botón "Instalar" de los gimnasios) siempre se revisa: así un cambio llega de una
/sw.js
  Cache-Control: no-cache
